---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Missing content entry: pages/home.md");
const { Content } = await render(entry);

// Key sections to link out to, in nav order, excluding Home itself and the
// Phase 2 News & Blog placeholder.
const allPages = await getCollection("pages");
const sectionLinks = allPages
  .filter((page) => page.data.showInNav && page.id !== "home" && page.id !== "news")
  .sort((a, b) => a.data.navOrder - b.data.navOrder);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="hero container">
    <h1>Ordo Servorum Mariae</h1>
    <p class="hero__motto">Servite Order — Indonesia Community</p>
    {entry.data.motto && <p class="hero__motto">&ldquo;{entry.data.motto}&rdquo;</p>}
  </section>

  <div class="container">
    {entry.data.placeholder && <PlaceholderNotice />}

    {entry.data.feastDay && (
      <div class="feast-banner">
        <strong>Feast Day</strong>
        <p>{entry.data.feastDay}</p>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav aria-label="Key sections">
      <ul class="section-links">
        {
          sectionLinks.map((page) => (
            <li>
              <a href={`/${page.id}/`}>{page.data.navLabel}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
