---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";

const entry = await getEntry("pages", "news");
if (!entry) throw new Error("Missing content entry: pages/news.md");
const { Content } = await render(entry);

const allPosts = await getCollection("posts", (post) => post.data.published);
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container">
    <article class="prose" style="padding-block: var(--space-4);">
      <h1>{entry.data.title}</h1>
      {entry.data.placeholder && <PlaceholderNotice />}
      <Content />
    </article>

    {
      posts.length === 0 ? (
        <p class="prose">No posts yet — check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-card">
              <a href={`/news/${post.id}/`}>
                {post.data.photo && (
                  <img
                    class="post-card__photo"
                    src={post.data.photo}
                    alt=""
                  />
                )}
                <div class="post-card__body">
                  <p class="post-meta">
                    {dateFormatter.format(post.data.publishDate)}
                  </p>
                  <h2>{post.data.title}</h2>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
